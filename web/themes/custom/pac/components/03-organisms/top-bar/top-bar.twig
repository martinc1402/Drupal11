<div class="top-bar" role="complementary" aria-label="Related sites and search">
  <div class="related-sites">
    <ul class="related-sites__list">
      {% for link in links %}
        <li>
          <a href="{{ link.href }}">
  {% if link.icon -%}
              <img src="{{ link.icon }}" alt="" aria-hidden="true" />
  {%- endif %}
            {{ link.text }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>